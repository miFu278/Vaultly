# Server configuration
PORT=8080
ENV=development

# Database configuration (PostgreSQL / Supabase)
# Option 1: Direct or Pooled Connection String (Recommended for Supabase)
# Session pooler (Port 5432): postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Or Direct connection: postgres://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Option 2: Individual DB Parameters (if not using DATABASE_URL)
DB_HOST=db.[PROJECT-REF].supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres
DB_SSLMODE=require

# JWT configuration
JWT_SECRET=super_secret_jwt_key_vaultly_change_in_production
JWT_EXPIRATION_HOURS=72

# Cloudflare R2 / S3 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=vaultly-storage
R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
PRESIGNED_URL_EXPIRATION_MINUTES=15

# Upload limits
# Per-request cap for /files/upload (images and videos). Requests above it are
# rejected with 413. Uploads stream through a temporary file, so the cap costs
# temp disk, not RAM: keep it under half of the free disk space.
MAX_UPLOAD_MB=512

# Memory
# The server caps the Go heap at 80% of the container's cgroup memory limit so a
# spike triggers GC instead of an OOM kill. Set GOMEMLIMIT to override, e.g.
# GOMEMLIMIT=384MiB on a 512 MiB instance (Go applies it at startup).
# GOMEMLIMIT=384MiB
