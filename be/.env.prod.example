# Copy to .env.prod and fill in. This file is read by docker compose, not baked
# into the image. Never commit .env.prod.
#
# Production refuses to start unless JWT_SECRET is a real secret and the R2
# credentials are present. That check is deliberate: the fallback secret is
# shared by every deployment, and a missing bucket silently becomes in-memory
# storage that loses data on restart.

# ---- Reverse proxy -------------------------------------------------------
# The domain whose A record points at this VPS. Caddy issues the certificate.
API_DOMAIN=api.example.com

# ---- Runtime -------------------------------------------------------------
ENV=production
PORT=8080
# Lets the Go heap grow to this before GC works harder. Leave room for the
# 64 KiB chunks and thumbnails; 3/4 of the container memory is a safe start.
GOMEMLIMIT=384MiB
MAX_UPLOAD_MB=200

# ---- Auth ----------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=720

# ---- Database (Supabase) -------------------------------------------------
# Use the pooler host, not db.<ref>.supabase.co: the direct host resolves to
# IPv6 only, which most VPS networks cannot reach.
#   Supabase dashboard -> Connect -> Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ---- Object storage (Cloudflare R2) --------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vaultly-storage
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
PRESIGNED_URL_EXPIRATION_MINUTES=15
